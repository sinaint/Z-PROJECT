# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워주세요.
# .env는 .gitignore에 포함되어 있어서 커밋되지 않아요.

# Django SECRET_KEY (세션/CSRF/비밀번호 재설정 토큰 서명 등에 쓰여요)
# 아래 명령으로 새로 발급받으세요:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=여기에-새로-발급한-랜덤-값-입력

# Claude API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-여기에-실제-키-입력

# AWS 자격 증명 (스캐너용, boto3가 사용)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
